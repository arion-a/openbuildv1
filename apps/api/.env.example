# Copy to apps/api/.env and fill in. Never commit the filled copy.

DATABASE_URL=postgres://openbuild:password@localhost:5432/openbuild
REDIS_URL=redis://localhost:6379

# 32+ random chars. Used to sign JWTs.
JWT_SECRET=change-me-to-a-random-secret
# 64 hex chars. Encrypts stored Gitea tokens. Falls back to JWT_SECRET if unset,
# but set it explicitly so rotating JWT_SECRET doesn't orphan encrypted data.
ENCRYPTION_KEY=change-me-to-64-hex-chars

# Gitea (repo hosting). Set GITEA_AUTO_PROVISION=false to skip account/repo
# creation entirely — auth and publish work without Gitea.
GITEA_URL=http://localhost:3000
GITEA_ADMIN_TOKEN=your-gitea-admin-token
GITEA_AUTO_PROVISION=false

# Firebase Admin (server-side token verification).
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-adminsdk.json
# Only for local dev against the Firebase Auth emulator; leave unset otherwise.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Coding sessions (dormant feature).
DOCKER_SOCKET=/var/run/docker.sock
SESSION_IMAGE=openbuild/session:latest
SESSION_TIMEOUT_HOURS=4
SESSION_MODE=process
SESSIONS_DIR=/tmp/sessions

# Optional — only needed for AI idea-thread summaries.
ANTHROPIC_API_KEY=your-anthropic-api-key

PORT=41935
