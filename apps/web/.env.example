VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Optional: avatar upload on Settings. App works without it.
# VITE_IMGBB_API_KEY=your-imgbb-api-key

# Optional: set to false to use real Firebase Auth (requires Authentication + providers in the Firebase console).
# VITE_FIREBASE_AUTH_EMULATOR=false
# Set this only if you want the browser to call the API directly.
# VITE_API_URL=http://localhost:41935
