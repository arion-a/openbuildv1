dist/
.env

# Coding-session repo clones (SESSIONS_DIR, when it's a path under the repo) —
# runtime state, not source; leaving these untracked-but-not-ignored made
# `git clean -fd` in the deploy script try (and fail) to delete them.
/sessions/

# Sensitive files
*.pem
*-firebase-adminsdk-*.json
open-build-prod-*.json

# Local env overrides (Vite)
*.local
.env.local

# TypeScript incremental build cache  (tsc -b writes these)
*.tsbuildinfo

# Claude Code machine-local settings
.claude/settings.local.json

# generic logs
*.log

# Export/design files
figma-export/

# Build artifacts / archives
openbuild.zip
*.zip

# Large/misc files
ChatGPT Image*.png
BuildStream feature.make

