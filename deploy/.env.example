DB_PASSWORD=change-me-strong-password
DATABASE_URL=postgres://openbuild:change-me-strong-password@localhost:5432/openbuild
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-random-64-chars
# 64 hex chars — encrypts stored Gitea tokens. Set explicitly (do not rely on the
# JWT_SECRET fallback) so rotating JWT_SECRET later doesn't orphan encrypted data.
ENCRYPTION_KEY=change-me-to-64-hex-chars
GITEA_URL=http://localhost:3000
GITEA_ADMIN_TOKEN=generate-after-first-boot
# Set to false to run without Gitea (auth + publish still work).
GITEA_AUTO_PROVISION=true
ANTHROPIC_API_KEY=sk-ant-...
SESSION_MODE=process
SESSIONS_DIR=/opt/openbuild/sessions
PORT=41935
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=/opt/openbuild/firebase-adminsdk.json
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token
