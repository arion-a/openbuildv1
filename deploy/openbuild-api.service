[Unit]
Description=OpenBuild API Server
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=openbuild
Group=openbuild
WorkingDirectory=/opt/openbuild/apps/api
EnvironmentFile=/opt/openbuild/.env
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
