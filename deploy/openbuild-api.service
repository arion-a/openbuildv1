[Unit]
Description=OpenBuild API Server
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/openbuild/apps/api
EnvironmentFile=/opt/openbuild/.env
Environment=PATH=/usr/local/bin:/usr/bin:/usr/sbin
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
